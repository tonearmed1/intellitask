# -----------------------------------------------------------------------------
# Intellitask — environment variables & secrets
#
# Local dev: copy this file to `.dev.vars` (wrangler's local secrets file) and
# fill in values you want to test with. `.dev.vars` is gitignored.
#
# Production: set secrets with `wrangler secret put <NAME>` — never commit them.
# Non-secret vars (AI_PROVIDER, AI_MODEL, ALLOW_WEB_RESEARCH, AUTH_USERNAME) are
# configured directly in wrangler.jsonc under "vars".
# -----------------------------------------------------------------------------

# --- Authentication (required) ---
# There is no env var for credentials. Create your single user account with:
#   npm run auth:create-user -- <username> <password>       (prints SQL)
#   npm run auth:create-user -- <username> <password> --apply --local   (writes to local D1)
#   npm run auth:create-user -- <username> <password> --apply --remote  (writes to production D1)
# See README "Authentication setup" for details.

# Random 32+ byte secret reserved for future use signing tokens. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# --- AI providers (at least one required unless AI_PROVIDER=mock) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Web research (optional; only used when ALLOW_WEB_RESEARCH=true) ---
# Brave Search API key: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
