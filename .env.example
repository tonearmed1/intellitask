# -----------------------------------------------------------------------------
# Intellitask — environment variables & secrets
#
# Local dev: copy this file to `.env` and fill in values. `npm run dev`
# (via scripts/dev-server.ts) reads `.env` automatically.
#
# Production (Vercel): set these in the Vercel dashboard → Project Settings →
# Environment Variables, or via `vercel env add <NAME>`. Connecting a
# Postgres database from the Storage tab sets DATABASE_URL automatically.
# -----------------------------------------------------------------------------

# --- Database (required) ---
# A standard Postgres connection string. Vercel Postgres / Neon set this
# automatically when you connect a database from the dashboard's Storage tab.
DATABASE_URL=

# --- Authentication (required) ---
# There is no env var for credentials. Create your single user account with:
#   DATABASE_URL=... npm run auth:create-user -- <username> <password>
# See README "Authentication setup" for details.

# Reserved for future use signing tokens. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- AI providers (at least one required unless AI_PROVIDER=mock) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Web research (optional; only used when ALLOW_WEB_RESEARCH=true) ---
# Brave Search API key: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# --- Non-secret config (also fine as plain Vercel project env vars) ---
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-4-5
ALLOW_WEB_RESEARCH=false
