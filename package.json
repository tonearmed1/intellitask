{
  "name": "intellitask",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "db:migrate:local": "wrangler d1 migrations apply intellitask-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply intellitask-db --remote",
    "db:seed:local": "wrangler d1 execute intellitask-db --local --file=./migrations/seed.sql",
    "cf-typegen": "wrangler types",
    "auth:create-user": "node scripts/create-user.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.4",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@eslint/js": "9.39.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.5.0",
    "jsdom": "30.0.1",
    "miniflare": "4.20260730.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
